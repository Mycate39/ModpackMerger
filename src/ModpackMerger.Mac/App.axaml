<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:ModpackMerger.Mac.Controls"
             x:Class="ModpackMerger.Mac.App"
             Name="Modpack Merger"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <!-- Typographie (police système : SF Pro sur Mac) -->
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.subtitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.strong">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Carte : fond légèrement contrasté, coins arrondis façon macOS -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Transitions">
                <Transitions>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.card.lift:pointerover">
            <Setter Property="BoxShadow" Value="0 6 18 0 #22000000" />
        </Style>

        <!-- Pastille de compteur -->
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="MinWidth" Value="20" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.badge > TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.badge.caution">
            <Setter Property="Background" Value="{DynamicResource CautionBrush}" />
        </Style>

        <!-- Boutons avec icône -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button ctl|Icon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>
        <Style Selector="Button > StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="8" />
        </Style>

        <!-- Barre latérale : liste de navigation façon Finder / Réglages Système -->
        <Style Selector="ListBox.nav">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavHoverBrush}" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem ctl|Icon">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <!-- Pastille de statut du plan d'injection -->
        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource NavHoverBrush}" />
        </Style>
        <Style Selector="Border.pill > TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
        <Style Selector="Border.pill.new">
            <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
        </Style>
        <Style Selector="Border.pill.new > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="Border.pill.conflict">
            <Setter Property="Background" Value="{DynamicResource CautionBackgroundBrush}" />
        </Style>
        <Style Selector="Border.pill.conflict > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource CautionBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SidebarBrush" Color="#B8ECECEC" />
                    <SolidColorBrush x:Key="ContentBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardBrush" Color="#F7F7F8" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#E3E3E6" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6E6E73" />
                    <SolidColorBrush x:Key="NavHoverBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="NavSelectedBrush" Color="#21000000" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#1F8A3B" />
                    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#E3F5E6" />
                    <SolidColorBrush x:Key="CautionBrush" Color="#B25E00" />
                    <SolidColorBrush x:Key="CautionBackgroundBrush" Color="#FFF3D6" />
                    <SolidColorBrush x:Key="CriticalBrush" Color="#D1242F" />
                    <SolidColorBrush x:Key="CriticalBackgroundBrush" Color="#FDE8E9" />
                    <SolidColorBrush x:Key="ToastBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SmokeBrush" Color="#66FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SidebarBrush" Color="#B8262628" />
                    <SolidColorBrush x:Key="ContentBrush" Color="#1E1E20" />
                    <SolidColorBrush x:Key="CardBrush" Color="#28282B" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#38383C" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A1A1A6" />
                    <SolidColorBrush x:Key="NavHoverBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="NavSelectedBrush" Color="#24FFFFFF" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#4CD964" />
                    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#1E3324" />
                    <SolidColorBrush x:Key="CautionBrush" Color="#FFC542" />
                    <SolidColorBrush x:Key="CautionBackgroundBrush" Color="#3D3018" />
                    <SolidColorBrush x:Key="CriticalBrush" Color="#FF6B6B" />
                    <SolidColorBrush x:Key="CriticalBackgroundBrush" Color="#45252A" />
                    <SolidColorBrush x:Key="ToastBrush" Color="#2C2C2E" />
                    <SolidColorBrush x:Key="SmokeBrush" Color="#66000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Couleur d'accent choisie dans Réglages Système › Apparence -->
            <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource SystemAccentColor}" />

            <!-- Icônes au trait, grille 24×24 (voir Controls/Icon.cs) -->
            <StreamGeometry x:Key="IconPackage">M12,3 L20,7.5 L20,16.5 L12,21 L4,16.5 L4,7.5 Z M4,7.5 L12,12 L20,7.5 M12,12 L12,21</StreamGeometry>
            <StreamGeometry x:Key="IconList">M9,6 L20,6 M9,12 L20,12 M9,18 L20,18 M4.5,6 L4.6,6 M4.5,12 L4.6,12 M4.5,18 L4.6,18</StreamGeometry>
            <StreamGeometry x:Key="IconMerge">M6,4 L6,20 M6,8 C6,12 9,14 13,14 L19,14 M16,11 L19,14 L16,17</StreamGeometry>
            <StreamGeometry x:Key="IconLog">M7,3.5 L17,3.5 A1.5,1.5 0 0 1 18.5,5 L18.5,19 A1.5,1.5 0 0 1 17,20.5 L7,20.5 A1.5,1.5 0 0 1 5.5,19 L5.5,5 A1.5,1.5 0 0 1 7,3.5 Z M9,8.5 L15,8.5 M9,12.5 L15,12.5 M9,16.5 L12.5,16.5</StreamGeometry>
            <StreamGeometry x:Key="IconSettings">M4,7 L12,7 M17,7 L20,7 M14.5,4.5 L14.5,9.5 M4,17 L7,17 M12,17 L20,17 M9.5,14.5 L9.5,19.5</StreamGeometry>
            <StreamGeometry x:Key="IconFolder">M3.5,7 A1.5,1.5 0 0 1 5,5.5 L9.5,5.5 L11.5,7.5 L19,7.5 A1.5,1.5 0 0 1 20.5,9 L20.5,17.5 A1.5,1.5 0 0 1 19,19 L5,19 A1.5,1.5 0 0 1 3.5,17.5 Z</StreamGeometry>
            <StreamGeometry x:Key="IconFile">M7,3.5 L14,3.5 L18.5,8 L18.5,19 A1.5,1.5 0 0 1 17,20.5 L7,20.5 A1.5,1.5 0 0 1 5.5,19 L5.5,5 A1.5,1.5 0 0 1 7,3.5 Z M14,3.5 L14,8 L18.5,8</StreamGeometry>
            <StreamGeometry x:Key="IconDownload">M12,4 L12,15 M7.5,10.5 L12,15 L16.5,10.5 M5,19.5 L19,19.5</StreamGeometry>
            <StreamGeometry x:Key="IconSearch">M4.5,10.5 A6,6 0 1 1 16.5,10.5 A6,6 0 1 1 4.5,10.5 Z M15,15 L20,20</StreamGeometry>
            <StreamGeometry x:Key="IconCheck">M5,12.5 L10,17.5 L19,7</StreamGeometry>
            <StreamGeometry x:Key="IconClose">M6.5,6.5 L17.5,17.5 M17.5,6.5 L6.5,17.5</StreamGeometry>
            <StreamGeometry x:Key="IconArrowRight">M5,12 L19,12 M13,6 L19,12 L13,18</StreamGeometry>
            <StreamGeometry x:Key="IconOpen">M14,4 L20,4 L20,10 M20,4 L11,13 M18,14 L18,18.5 A1.5,1.5 0 0 1 16.5,20 L5.5,20 A1.5,1.5 0 0 1 4,18.5 L4,7.5 A1.5,1.5 0 0 1 5.5,6 L10,6</StreamGeometry>
            <StreamGeometry x:Key="IconSwap">M4,9 L18,9 M15,6 L18,9 L15,12 M20,15 L6,15 M9,12 L6,15 L9,18</StreamGeometry>
            <StreamGeometry x:Key="IconSkip">M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 Z M5.6,18.4 L18.4,5.6</StreamGeometry>
            <StreamGeometry x:Key="IconWarning">M12,4 L21,19.5 L3,19.5 Z M12,10 L12,14 M12,16.8 L12,16.9</StreamGeometry>
            <StreamGeometry x:Key="IconInfo">M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 Z M12,11 L12,16.5 M12,7.8 L12,7.9</StreamGeometry>
            <StreamGeometry x:Key="IconSuccess">M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 Z M8,12.5 L11,15.5 L16.5,9.5</StreamGeometry>
            <StreamGeometry x:Key="IconError">M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 Z M9,9 L15,15 M15,9 L9,15</StreamGeometry>
        </ResourceDictionary>
    </Application.Resources>
</Application>
