<Window x:Class="ModpackMerger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ModpackMerger.App.ViewModels"
        xmlns:inj="clr-namespace:ModpackMerger.Core.Injection;assembly=ModpackMerger.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Modpack Merger" Icon="/Assets/app.ico" Height="760" Width="1180" MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="⚙ Réglages" Command="{Binding OpenSettingsCommand}" Padding="12,6" />
            <StackPanel>
                <TextBlock Text="Modpack Merger" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Injectez les mods d'un modpack public dans votre modpack personnel." Opacity="0.7" />
            </StackPanel>
        </DockPanel>

        <!-- Étapes 1 et 2 -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="1 · MODPACK PUBLIC (SOURCE)" Style="{StaticResource StepTitle}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Importer…" Command="{Binding ImportCommand}" Padding="14,6" Margin="12,0,0,0"
                                ToolTip="Fichier .zip (CurseForge) ou .mrpack (Modrinth). Vous pouvez aussi le glisser sur la fenêtre." />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding PackTitle}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding PackDetails}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="2 · MODPACK PERSONNEL (DOSSIER « MODS » CIBLE)" Style="{StaticResource StepTitle}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="📂" Command="{Binding OpenTargetFolderCommand}" Padding="10,6" Margin="6,0,0,0"
                                ToolTip="Ouvrir dans l'explorateur" />
                        <Button DockPanel.Dock="Right" Content="Parcourir…" Command="{Binding BrowseTargetCommand}" Padding="14,6" Margin="12,0,0,0" />
                        <TextBox Text="{Binding TargetFolder, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                                 ToolTip="Dossier « mods » de votre instance (CurseForge App, Prism, MultiMC, .minecraft…)" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Onglets -->
        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTab}">

            <TabItem Header="Mods du pack">
                <DockPanel Margin="0,8,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SelectionSummary}" VerticalAlignment="Center" Opacity="0.7" Margin="12,0,0,0" />
                        <Button DockPanel.Dock="Left" Content="Tout cocher" Command="{Binding SelectAllCommand}" Padding="10,4" />
                        <Button DockPanel.Dock="Left" Content="Tout décocher" Command="{Binding SelectNoneCommand}" Padding="10,4" Margin="6,0,12,0" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                                 ToolTip="Filtrer par nom ou fichier (les boutons cocher/décocher n'agissent que sur les mods affichés)" />
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding ModsView}" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Extended"
                              IsReadOnly="False" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="44" SortMemberPath="IsSelected">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Mod" Binding="{Binding DisplayName}" Width="2*" MinWidth="140" IsReadOnly="True" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Version" Binding="{Binding Version}" Width="*" MinWidth="80" IsReadOnly="True" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Fichier" Binding="{Binding FileName}" Width="2*" MinWidth="140" IsReadOnly="True" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Source" Binding="{Binding SourceLabel}" Width="140" IsReadOnly="True" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Remarques" Binding="{Binding Notes}" Width="150" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Doublons &amp; plan d'injection">
                <DockPanel Margin="0,8,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Ignorer tous les doublons" Padding="10,4" Margin="6,0,0,0"
                                Command="{Binding SetAllConflictsCommand}" CommandParameter="{x:Static inj:ConflictAction.Skip}" />
                        <Button DockPanel.Dock="Right" Content="Remplacer tous les doublons" Padding="10,4"
                                Command="{Binding SetAllConflictsCommand}" CommandParameter="{x:Static inj:ConflictAction.Replace}" />
                        <TextBlock Text="{Binding PlanSummary}" VerticalAlignment="Center" Opacity="0.8" TextWrapping="Wrap" />
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Plan}" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Mod" Binding="{Binding Name}" Width="2*" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Statut" Width="1.4*" SortMemberPath="Kind">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Kind, Converter={StaticResource EnumLabel}}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConflict}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="#E8A33D" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static inj:ConflictKind.Identical}">
                                                            <Setter Property="Opacity" Value="0.55" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Version entrante" Binding="{Binding IncomingVersion}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Version existante" Binding="{Binding ExistingVersion}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Fichier existant" Binding="{Binding ExistingFile}" Width="1.6*" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Action" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding AvailableActions}"
                                                  SelectedItem="{Binding Action, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanChangeAction}" Margin="2">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Journal">
                <ScrollViewer x:Name="LogScroll" Margin="0,8,0,0" Padding="8" HorizontalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="LogList" ItemsSource="{Binding Log}" FontFamily="Cascadia Mono, Consolas" FontSize="12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Barre d'actions -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                <Button Content="Annuler" Command="{Binding CancelCommand}" Padding="14,8" Margin="0,0,6,0" />
                <Button Content="3 · Analyser" Command="{Binding AnalyzeCommand}" Padding="16,8" Margin="0,0,6,0"
                        ToolTip="Télécharge les mods sélectionnés et les compare au dossier cible" />
                <Button Content="4 · Injecter" Command="{Binding InjectCommand}" Padding="16,8"
                        Style="{DynamicResource AccentButtonStyle}"
                        ToolTip="Copie les mods dans le dossier cible selon le plan" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                <ProgressBar Height="6" Value="{Binding ProgressValue}" Maximum="{Binding ProgressMaximum}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
