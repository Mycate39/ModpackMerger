<Window x:Class="ModpackMerger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ModpackMerger.App.ViewModels"
        xmlns:anim="clr-namespace:ModpackMerger.App.Animations"
        xmlns:inj="clr-namespace:ModpackMerger.Core.Injection;assembly=ModpackMerger.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Modpack Merger" Icon="/Assets/app.ico"
        Height="800" Width="1240" MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragEnter="OnWindowDragEnter">

    <Window.Resources>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="CellSecondaryText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- Pastille de statut dans le plan d'injection -->
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static inj:ConflictKind.New}">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsConflict}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusPillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static inj:ConflictKind.New}">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsConflict}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Pastille d'étape : numéro, puis coche verte animée une fois l'étape faite -->
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StepDone" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════════ Volet de navigation ═══════════════ -->
        <DockPanel Grid.Column="0" Margin="8,8,4,12" anim:Anim.Entrance="True">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,8,0,20">
                <Image Source="/Assets/app.ico" Width="32" Height="32" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Modpack Merger" Style="{StaticResource BodyStrongText}" FontSize="16" />
                    <TextBlock Text="Fusion de modpacks Minecraft" Style="{StaticResource CaptionText}" />
                </StackPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom">
                <Rectangle Height="1" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="8,0,8,8" />
                <Button AutomationProperties.Name="Réglages" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="16,10" Background="Transparent" BorderThickness="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" />
                        <TextBlock Text="Réglages" Margin="16,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Style="{StaticResource CaptionText}" Margin="16,8,0,0" Opacity="0.7">
                    <Run Text="Version" /> <Run Text="{x:Static vm:MainViewModel.AppVersion}" />
                </TextBlock>
            </StackPanel>

            <!-- Éléments + indicateur d'accent qui glisse vers l'élément sélectionné -->
            <Grid x:Name="NavHost">
                <StackPanel x:Name="NavItems">
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8B7;"
                                 IsChecked="{Binding SelectedPage, Converter={StaticResource Equals}, ConverterParameter=0}">
                        <TextBlock Text="Configuration" VerticalAlignment="Center" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8FD;"
                                 IsChecked="{Binding SelectedPage, Converter={StaticResource Equals}, ConverterParameter=1}">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}"
                                    Visibility="{Binding HasPack, Converter={StaticResource BoolToVis}}"
                                    anim:Anim.PopValue="{Binding SelectedCount}">
                                <TextBlock Text="{Binding SelectedCount}" Style="{StaticResource BadgeText}" />
                            </Border>
                            <TextBlock Text="Mods du pack" VerticalAlignment="Center" />
                        </DockPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8C8;"
                                 IsChecked="{Binding SelectedPage, Converter={StaticResource Equals}, ConverterParameter=2}">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}"
                                    Background="{DynamicResource SystemFillColorCautionBrush}"
                                    Visibility="{Binding ConflictCount, Converter={StaticResource PositiveToVis}}"
                                    anim:Anim.PopOnVisible="True">
                                <TextBlock Text="{Binding ConflictCount}" Style="{StaticResource BadgeText}" Foreground="Black" />
                            </Border>
                            <TextBlock Text="Doublons &amp; plan" VerticalAlignment="Center" />
                        </DockPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE81C;"
                                 IsChecked="{Binding SelectedPage, Converter={StaticResource Equals}, ConverterParameter=3}">
                        <TextBlock Text="Journal" VerticalAlignment="Center" />
                    </RadioButton>
                </StackPanel>
                <Border x:Name="NavIndicator" Width="3" Height="16" CornerRadius="1.5" Margin="0,0,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
                        Background="{DynamicResource AccentFillColorDefaultBrush}" />
            </Grid>
        </DockPanel>

        <!-- ═══════════════ Zone de contenu (couche Fluent arrondie) ═══════════════ -->
        <Border Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                anim:Anim.Entrance="True" anim:Anim.EntranceDelay="80">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ─────────── Page 0 : Configuration ─────────── -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" anim:Anim.RevealOnVisible="True"
                              Visibility="{Binding SelectedPage, Converter={StaticResource EqualsToVis}, ConverterParameter=0}">
                    <StackPanel Margin="36,32,36,24" MaxWidth="1000">
                        <TextBlock Text="Configuration" Style="{StaticResource TitleText}" />
                        <TextBlock Text="Choisis le modpack à fusionner et le modpack personnel qui recevra ses mods."
                                   Style="{StaticResource SubtitleText}" Margin="0,4,0,24" />

                        <!-- Étape 1 : source -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                                anim:Anim.Entrance="True" anim:Anim.EntranceDelay="120" anim:Anim.HoverLift="True">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,16">
                                    <Grid DockPanel.Dock="Left" Margin="0,0,16,0">
                                        <Border Style="{StaticResource StepNumber}"
                                                Visibility="{Binding HasPack, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                            <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource StepDone}" anim:Anim.PopOnVisible="True"
                                                Visibility="{Binding HasPack, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="Black" FontSize="14" />
                                        </Border>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Modpack source" Style="{StaticResource BodyStrongText}" FontSize="16" />
                                        <TextBlock Text="Archive CurseForge (.zip), Modrinth (.mrpack), ou dossier : instance, dossier « mods », pack décompressé."
                                                   Style="{StaticResource CaptionText}" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- Zone de dépôt (avant import) -->
                                <Grid anim:Anim.RevealOnVisible="True"
                                      Visibility="{Binding HasPack, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                    <Rectangle RadiusX="8" RadiusY="8" StrokeThickness="1.5" StrokeDashArray="5 4"
                                               Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                                               Fill="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                    <StackPanel Margin="24,28" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="40" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" anim:Anim.Float="True" />
                                        <TextBlock Text="Glisse un fichier .zip / .mrpack ou un dossier ici" Style="{StaticResource BodyStrongText}"
                                                   HorizontalAlignment="Center" Margin="0,14,0,4" />
                                        <TextBlock Text="ou choisis-le manuellement" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                            <Button AutomationProperties.Name="Choisir un fichier" Command="{Binding ImportFileCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="16,8" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" />
                                                    <TextBlock Text="Choisir un fichier" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button AutomationProperties.Name="Choisir un dossier" Command="{Binding ImportFolderCommand}" Padding="16,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" />
                                                    <TextBlock Text="Choisir un dossier" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Pack importé -->
                                <DockPanel anim:Anim.RevealOnVisible="True"
                                           Visibility="{Binding HasPack, Converter={StaticResource BoolToVis}}">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Command="{Binding ImportFileCommand}" Padding="12,6" Margin="0,0,6,0" ToolTip="Importer une autre archive">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" FontSize="14" />
                                                <TextBlock Text="Fichier…" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding ImportFolderCommand}" Padding="12,6" ToolTip="Importer un autre dossier">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="14" />
                                                <TextBlock Text="Dossier…" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <Border DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="8" Margin="0,0,16,0"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <Image Source="/Assets/app.ico" Width="32" Height="32" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding PackTitle}" Style="{StaticResource BodyStrongText}" FontSize="18" TextTrimming="CharacterEllipsis" />
                                            <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Height="20" CornerRadius="10">
                                                <TextBlock Text="{Binding PackFormatLabel}" Style="{StaticResource BadgeText}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding PackDetails}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- Chemin saisi ou collé (dossier ou archive), validé par Entrée ou le bouton -->
                                <DockPanel Margin="0,16,0,0">
                                    <Button DockPanel.Dock="Right" AutomationProperties.Name="Importer le chemin"
                                            Command="{Binding ImportPathCommand}" Padding="14,8" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="14" />
                                            <TextBlock Text="Importer" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Grid>
                                        <TextBox AutomationProperties.Name="Chemin du modpack source"
                                                 Text="{Binding SourcePathInput, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="34,6,10,6" VerticalContentAlignment="Center"
                                                 ToolTip="Chemin d'un dossier (instance, dossier « mods », pack décompressé) ou d'une archive .zip / .mrpack">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding ImportPathCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="14" Margin="12,0,0,0" HorizontalAlignment="Left"
                                                   IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="…ou colle ici le chemin d'un dossier ou d'une archive, puis Entrée" Style="{StaticResource CaptionText}"
                                                   Margin="36,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center" Opacity="0.7"
                                                   Visibility="{Binding SourcePathInput, Converter={StaticResource EmptyToVis}}" />
                                    </Grid>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Étape 2 : cible -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                                anim:Anim.Entrance="True" anim:Anim.EntranceDelay="200" anim:Anim.HoverLift="True">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,16">
                                    <Grid DockPanel.Dock="Left" Margin="0,0,16,0">
                                        <Border Style="{StaticResource StepNumber}"
                                                Visibility="{Binding HasTarget, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                            <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource StepDone}" anim:Anim.PopOnVisible="True"
                                                Visibility="{Binding HasTarget, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="Black" FontSize="14" />
                                        </Border>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Modpack personnel" Style="{StaticResource BodyStrongText}" FontSize="16" />
                                        <TextBlock Text="Le dossier « mods » de ton instance (CurseForge App, Prism, MultiMC, .minecraft…). Le dossier de l'instance fonctionne aussi."
                                                   Style="{StaticResource CaptionText}" />
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding OpenTargetFolderCommand}" Padding="10,8" Margin="6,0,0,0"
                                            ToolTip="Ouvrir dans l'explorateur">
                                        <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="14" />
                                    </Button>
                                    <Button DockPanel.Dock="Right" Command="{Binding BrowseTargetCommand}" Padding="14,8" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="14" />
                                            <TextBlock Text="Parcourir…" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Grid>
                                        <TextBox AutomationProperties.Name="Dossier cible" Text="{Binding TargetFolder, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                                        <TextBlock Text="C:\…\MonInstance\mods" Style="{StaticResource CaptionText}" Margin="12,0" IsHitTestVisible="False"
                                                   VerticalAlignment="Center" Opacity="0.7"
                                                   Visibility="{Binding TargetFolder, Converter={StaticResource EmptyToVis}}" />
                                    </Grid>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Étape suivante -->
                        <Border Style="{StaticResource Card}" anim:Anim.Entrance="True" anim:Anim.EntranceDelay="280">
                            <Grid>
                                <DockPanel anim:Anim.RevealOnVisible="True"
                                           Visibility="{Binding HasTarget, Converter={StaticResource BoolToVis}}">
                                    <Button DockPanel.Dock="Right" Command="{Binding NavigateCommand}" CommandParameter="1"
                                            Style="{DynamicResource AccentButtonStyle}" Padding="16,8"
                                            IsEnabled="{Binding HasPack}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Choisir les mods" />
                                            <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="12" Margin="10,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,16,0"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Étape 3 · Sélection des mods" Style="{StaticResource BodyStrongText}" />
                                        <TextBlock Text="Décoche les mods à exclure, puis lance l'analyse des doublons." Style="{StaticResource CaptionText}" />
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Visibility="{Binding HasTarget, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                    <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,16,0" Opacity="0.6" />
                                    <TextBlock Text="Complète les étapes 1 et 2 pour continuer." Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ─────────── Page 1 : Mods du pack ─────────── -->
                <Grid Grid.Row="0" Margin="36,32,36,16" anim:Anim.RevealOnVisible="True"
                      Visibility="{Binding SelectedPage, Converter={StaticResource EqualsToVis}, ConverterParameter=1}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,20">
                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Height="28" CornerRadius="14" Padding="14,0"
                                Visibility="{Binding HasPack, Converter={StaticResource BoolToVis}}"
                                anim:Anim.PopValue="{Binding SelectedCount}">
                            <TextBlock Style="{StaticResource BadgeText}" FontSize="13">
                                <Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=" sélectionnés" />
                            </TextBlock>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Mods du pack" Style="{StaticResource TitleText}" />
                            <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource SubtitleText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Grid.Row="1" Margin="0,0,0,12" Visibility="{Binding HasPack, Converter={StaticResource BoolToVis}}">
                        <Button DockPanel.Dock="Right" Command="{Binding SelectNoneCommand}" Padding="12,6" Margin="6,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="12" />
                                <TextBlock Text="Tout décocher" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Command="{Binding SelectAllCommand}" Padding="12,6" Margin="12,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73A;" Style="{StaticResource Icon}" FontSize="12" />
                                <TextBlock Text="Tout cocher" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Grid MaxWidth="420" HorizontalAlignment="Left" Width="420">
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,6,10,6" VerticalContentAlignment="Center"
                                     ToolTip="Filtrer par nom ou fichier (cocher/décocher n'agit que sur les mods affichés)" />
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14" Margin="12,0,0,0" HorizontalAlignment="Left"
                                       IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Rechercher un mod" Style="{StaticResource CaptionText}" Margin="36,0,0,0" IsHitTestVisible="False"
                                       VerticalAlignment="Center" Opacity="0.7"
                                       Visibility="{Binding SearchText, Converter={StaticResource EmptyToVis}}" />
                        </Grid>
                    </DockPanel>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"
                            Visibility="{Binding HasPack, Converter={StaticResource BoolToVis}}">
                        <DataGrid x:Name="ModsGrid" ItemsSource="{Binding ModsView}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Extended" RowHeaderWidth="0"
                                  BorderThickness="0" Background="Transparent" RowHeight="40" LoadingRow="OnLoadingRow">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="52" SortMemberPath="IsSelected">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Mod" Binding="{Binding DisplayName}" Width="2*" MinWidth="160" IsReadOnly="True" />
                                <DataGridTextColumn ElementStyle="{StaticResource CellSecondaryText}" Header="Version" Binding="{Binding Version}" Width="*" MinWidth="90" IsReadOnly="True" />
                                <DataGridTextColumn ElementStyle="{StaticResource CellSecondaryText}" Header="Fichier" Binding="{Binding FileName}" Width="2*" MinWidth="160" IsReadOnly="True" />
                                <DataGridTextColumn ElementStyle="{StaticResource CellSecondaryText}" Header="Source" Binding="{Binding SourceLabel}" Width="150" IsReadOnly="True" />
                                <DataGridTextColumn ElementStyle="{StaticResource CellSecondaryText}" Header="Remarques" Binding="{Binding Notes}" Width="140" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- État vide -->
                    <StackPanel Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                anim:Anim.RevealOnVisible="True"
                                Visibility="{Binding HasPack, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" FontSize="56" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" anim:Anim.Float="True" />
                        <TextBlock Text="Aucun modpack importé" Style="{StaticResource BodyStrongText}" FontSize="18" HorizontalAlignment="Center" Margin="0,20,0,4" />
                        <TextBlock Text="Importe un modpack pour voir ses mods ici." Style="{StaticResource CaptionText}" HorizontalAlignment="Center" />
                        <Button Command="{Binding NavigateCommand}" CommandParameter="0" Style="{DynamicResource AccentButtonStyle}"
                                Padding="16,8" Margin="0,20,0,0" HorizontalAlignment="Center" Content="Aller à la configuration" />
                    </StackPanel>
                </Grid>

                <!-- ─────────── Page 2 : Doublons & plan ─────────── -->
                <Grid Grid.Row="0" Margin="36,32,36,16" anim:Anim.RevealOnVisible="True"
                      Visibility="{Binding SelectedPage, Converter={StaticResource EqualsToVis}, ConverterParameter=2}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Doublons &amp; plan d'injection" Style="{StaticResource TitleText}" />
                        <TextBlock Text="{Binding PlanSummary}" Style="{StaticResource SubtitleText}" Margin="0,4,0,0" />
                    </StackPanel>

                    <DockPanel Grid.Row="1" Margin="0,0,0,12" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}">
                        <Button DockPanel.Dock="Right" Command="{Binding SetAllConflictsCommand}" CommandParameter="{x:Static inj:ConflictAction.Skip}"
                                Padding="12,6" Margin="6,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8D8;" Style="{StaticResource Icon}" FontSize="12" />
                                <TextBlock Text="Ignorer tous les doublons" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Command="{Binding SetAllConflictsCommand}" CommandParameter="{x:Static inj:ConflictAction.Replace}"
                                Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8AB;" Style="{StaticResource Icon}" FontSize="12" />
                                <TextBlock Text="Remplacer tous les doublons" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Border HorizontalAlignment="Left" CornerRadius="6" Padding="12,6"
                                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                Visibility="{Binding ConflictCount, Converter={StaticResource PositiveToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Run Text="{Binding ConflictCount, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" doublon(s) : choisis l'action de chacun" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DockPanel>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"
                            Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}">
                        <DataGrid x:Name="PlanGrid" ItemsSource="{Binding Plan}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="0"
                                  BorderThickness="0" Background="Transparent" MinRowHeight="44" LoadingRow="OnLoadingRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Mod" Binding="{Binding Name}" Width="1.6*" MinWidth="140" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="Statut" Width="210" SortMemberPath="Kind">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StatusPill}" Margin="6,0">
                                                <TextBlock Text="{Binding Kind, Converter={StaticResource EnumLabel}}" Style="{StaticResource StatusPillText}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn ElementStyle="{StaticResource CellSecondaryText}" Header="Entrante" Binding="{Binding IncomingVersion}" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn ElementStyle="{StaticResource CellSecondaryText}" Header="Existante" Binding="{Binding ExistingVersion}" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn ElementStyle="{StaticResource CellSecondaryText}" Header="Fichier(s) existant(s)" Binding="{Binding ExistingFile}" Width="2*" MinWidth="160" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="Action" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding AvailableActions}"
                                                      SelectedItem="{Binding Action, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding CanChangeAction}" Margin="4" VerticalAlignment="Center">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- État vide -->
                    <StackPanel Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                anim:Anim.RevealOnVisible="True"
                                Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="56" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" anim:Anim.Float="True" />
                        <TextBlock Text="Pas encore d'analyse" Style="{StaticResource BodyStrongText}" FontSize="18" HorizontalAlignment="Center" Margin="0,20,0,4" />
                        <TextBlock Text="Lance l'analyse pour comparer ta sélection avec ton modpack personnel." Style="{StaticResource CaptionText}" HorizontalAlignment="Center" />
                        <Button Command="{Binding AnalyzeCommand}" Style="{DynamicResource AccentButtonStyle}"
                                Padding="16,8" Margin="0,20,0,0" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14" />
                                <TextBlock Text="Analyser maintenant" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ─────────── Page 3 : Journal ─────────── -->
                <Grid Grid.Row="0" Margin="36,32,36,16" anim:Anim.RevealOnVisible="True"
                      Visibility="{Binding SelectedPage, Converter={StaticResource EqualsToVis}, ConverterParameter=3}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Journal" Style="{StaticResource TitleText}" />
                        <TextBlock Text="Historique détaillé des opérations de cette session." Style="{StaticResource SubtitleText}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
                        <ScrollViewer x:Name="LogScroll" Padding="12" HorizontalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="LogList" ItemsSource="{Binding Log}" FontFamily="Cascadia Mono, Consolas" FontSize="12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Margin="0,2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ─────────── Barre de commandes ─────────── -->
                <Border Grid.Row="1" Margin="36,0,36,24" Style="{StaticResource Card}" Padding="20,14"
                        anim:Anim.Entrance="True" anim:Anim.EntranceDelay="360">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
                            <Button AutomationProperties.Name="Annuler" Command="{Binding CancelCommand}" Padding="14,8" Margin="0,0,8,0" anim:Anim.PopOnVisible="True"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="12" />
                                    <TextBlock Text="Annuler" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="Analyser" Command="{Binding AnalyzeCommand}" Padding="16,8" Margin="0,0,8,0"
                                    ToolTip="Récupère les mods sélectionnés et les compare au dossier cible">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14" />
                                    <TextBlock Text="Analyser" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="Injecter" Command="{Binding InjectCommand}" Padding="16,8" Style="{DynamicResource AccentButtonStyle}"
                                    ToolTip="Copie les mods dans le dossier cible selon le plan">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="14" />
                                    <TextBlock Text="Injecter" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                            <ProgressBar Height="4" Margin="0,8,0,0" Maximum="{Binding ProgressMaximum}"
                                         anim:Anim.SmoothValue="{Binding ProgressValue}"
                                         IsIndeterminate="{Binding IsProgressIndeterminate}"
                                         anim:Anim.RevealOnVisible="True"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════ Notification (InfoBar) ═══════════════ -->
        <Border x:Name="Toast" Grid.Column="1" Width="400" Margin="0,20,24,0"
                HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Visibility="Collapsed">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.28" />
            </Border.Effect>
            <Border CornerRadius="7" Padding="16,14">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NotificationSeverity}" Value="{x:Static vm:NotificationSeverity.Success}">
                                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NotificationSeverity}" Value="{x:Static vm:NotificationSeverity.Warning}">
                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NotificationSeverity}" Value="{x:Static vm:NotificationSeverity.Error}">
                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding CloseNotificationCommand}" Padding="6" VerticalAlignment="Top"
                            Background="Transparent" BorderThickness="0" Margin="8,-4,-6,0">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10" />
                    </Button>
                    <TextBlock x:Name="ToastIcon" DockPanel.Dock="Left" FontSize="18" Margin="0,1,12,0" VerticalAlignment="Top"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                <Setter Property="Text" Value="&#xF167;" />
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorAttentionBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NotificationSeverity}" Value="{x:Static vm:NotificationSeverity.Success}">
                                        <Setter Property="Text" Value="&#xEC61;" />
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NotificationSeverity}" Value="{x:Static vm:NotificationSeverity.Warning}">
                                        <Setter Property="Text" Value="&#xE7BA;" />
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NotificationSeverity}" Value="{x:Static vm:NotificationSeverity.Error}">
                                        <Setter Property="Text" Value="&#xEB90;" />
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel>
                        <TextBlock Text="{Binding NotificationTitle}" Style="{StaticResource BodyStrongText}" />
                        <TextBlock Text="{Binding NotificationMessage}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Border>

        <!-- ═══════════════ Superposition de glisser-déposer ═══════════════ -->
        <Grid x:Name="DropOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" AllowDrop="True"
              Background="{DynamicResource SmokeFillColorDefaultBrush}"
              DragOver="OnOverlayDragOver" DragLeave="OnOverlayDragLeave" Drop="OnOverlayDrop">
            <Border x:Name="DropCard" Width="460" Height="260" CornerRadius="12" Padding="10"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.35" />
                </Border.Effect>
                <Grid>
                    <Rectangle RadiusX="8" RadiusY="8" StrokeThickness="2" StrokeDashArray="6 4"
                               Stroke="{DynamicResource AccentFillColorDefaultBrush}" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="DropIcon" Text="&#xE896;" Style="{StaticResource Icon}" FontSize="52" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Dépose pour importer" Style="{StaticResource BodyStrongText}" FontSize="20" HorizontalAlignment="Center" Margin="0,16,0,4" />
                        <TextBlock Text="Archive .zip / .mrpack ou dossier de modpack" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
