<Window x:Class="ModpackMerger.App.Views.InstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:anim="clr-namespace:ModpackMerger.App.Animations"
        Title="Installer Modpack Merger" Icon="/Assets/app.ico"
        Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="32,28,32,24">
        <StackPanel Orientation="Horizontal" anim:Anim.Entrance="True">
            <Image x:Name="Logo" Source="/Assets/logo.png" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="Heading" Text="Installer Modpack Merger" Style="{StaticResource TitleText}" FontSize="24" />
                <TextBlock x:Name="VersionText" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <Border Style="{StaticResource Card}" Margin="0,24,0,0" Padding="18,16"
                anim:Anim.Entrance="True" anim:Anim.EntranceDelay="90">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Margin="0,0,14,0"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel>
                        <TextBlock Text="Emplacement" Style="{StaticResource BodyStrongText}" />
                        <TextBlock x:Name="LocationText" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
                <TextBlock Style="{StaticResource CaptionText}" Margin="28,10,0,0"
                           Text="Installée pour ton compte Windows, sans droits administrateur. Raccourci dans le menu Démarrer, désinstallation depuis Paramètres › Applications." />
                <CheckBox x:Name="DesktopShortcut" Content="Créer un raccourci sur le bureau" IsChecked="True" Margin="28,14,0,0" />
            </StackPanel>
        </Border>

        <!-- Message d'erreur (ex. application déjà ouverte pendant une mise à jour) -->
        <Border x:Name="ErrorBar" Visibility="Collapsed" CornerRadius="6" Padding="14,10" Margin="0,12,0,0"
                Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}" anim:Anim.RevealOnVisible="True">
            <DockPanel>
                <TextBlock Text="&#xEB90;" Style="{StaticResource Icon}" Margin="0,0,10,0" VerticalAlignment="Top"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <ProgressBar x:Name="Progress" IsIndeterminate="True" Height="4" Margin="0,16,0,0" Visibility="Hidden" />

        <DockPanel Margin="0,12,0,0" anim:Anim.Entrance="True" anim:Anim.EntranceDelay="180">
            <Button x:Name="InstallButton" DockPanel.Dock="Right" Style="{DynamicResource AccentButtonStyle}" Padding="20,8"
                    AutomationProperties.Name="Installer" IsDefault="True" Click="OnInstall">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="14" />
                    <TextBlock x:Name="InstallLabel" Text="Installer" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Padding="16,8" Margin="0,0,8,0" Content="Utiliser sans installer"
                    AutomationProperties.Name="Utiliser sans installer" Click="OnPortable" />
            <Button DockPanel.Dock="Left" Padding="16,8" Content="Annuler" IsCancel="True" HorizontalAlignment="Left" />
        </DockPanel>
    </StackPanel>
</Window>
