<Window x:Class="ModpackMerger.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:anim="clr-namespace:ModpackMerger.App.Animations"
        Title="Réglages" Icon="/Assets/app.ico" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="28,24,28,20">
        <TextBlock Text="Réglages" Style="{StaticResource TitleText}" FontSize="24" Margin="0,0,0,18" anim:Anim.Entrance="True" />

        <!-- Mises à jour -->
        <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,12" anim:Anim.Entrance="True" anim:Anim.EntranceDelay="70">
            <DockPanel>
                <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" Margin="0,2,14,0" VerticalAlignment="Top"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel>
                    <TextBlock Text="Mises à jour" Style="{StaticResource BodyStrongText}" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource CaptionText}" Margin="0,2,0,10" />
                    <CheckBox x:Name="CheckUpdatesBox" Content="Rechercher les mises à jour au démarrage" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Clé API CurseForge -->
        <Border Style="{StaticResource Card}" Padding="18,16" anim:Anim.Entrance="True" anim:Anim.EntranceDelay="140">
            <DockPanel>
                <TextBlock Text="&#xE8D7;" Style="{StaticResource Icon}" Margin="0,2,14,0" VerticalAlignment="Top"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel>
                    <TextBlock Text="Clé API CurseForge (optionnelle)" Style="{StaticResource BodyStrongText}" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,10">
                        Sans clé, les mods CurseForge sont téléchargés via le lien public et leurs noms sont déduits des fichiers.
                        Avec une clé (gratuite sur
                        <Hyperlink NavigateUri="https://console.curseforge.com" RequestNavigate="OnNavigate">console.curseforge.com</Hyperlink>),
                        les noms exacts s'affichent dès l'import.
                    </TextBlock>
                    <PasswordBox x:Name="KeyBox" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Enregistrer" IsDefault="True" Click="OnSave" Padding="18,7" Margin="0,0,8,0"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Annuler" IsCancel="True" Padding="18,7" />
        </StackPanel>
    </StackPanel>
</Window>
